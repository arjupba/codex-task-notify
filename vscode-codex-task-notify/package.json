{
  "name": "codex-task-notify",
  "displayName": "Codex Task Notify",
  "description": "Local task-completion notifications for Codex across Windows, WSL, and Remote SSH. 为 Codex 提供跨 Windows、WSL 与 Remote SSH 的本地任务完成通知。",
  "version": "0.0.1",
  "publisher": "rmargin",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://github.com/Gtyro/codex-task-notify",
  "bugs": {
    "url": "https://github.com/Gtyro/codex-task-notify/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Gtyro/codex-task-notify.git"
  },
  "engines": {
    "vscode": "^1.121.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "notification",
    "windows",
    "wsl",
    "remote-ssh",
    "remote-development"
  ],
  "galleryBanner": {
    "color": "#1f2937",
    "theme": "dark"
  },
  "extensionKind": [
    "ui"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:codexTaskNotify.showDiagnostics",
    "onCommand:codexTaskNotify.showRecentHistory",
    "onCommand:codexTaskNotify.testNotification",
    "onCommand:codexTaskNotify.installLocalCli",
    "onCommand:codexTaskNotify.installWorkspaceCli"
  ],
  "contributes": {
    "configuration": {
      "title": "Codex Task Notify",
      "properties": {
        "codexTaskNotify.sessionsRoot": {
          "type": "string",
          "default": "",
          "description": "Optional Codex sessions root path. Leave empty to auto-detect. Useful for Remote SSH, WSL, or custom .codex locations."
        },
        "codexTaskNotify.sessionPollMs": {
          "type": "number",
          "default": 1500,
          "minimum": 500,
          "description": "Polling interval in milliseconds for Codex session file monitoring."
        },
        "codexTaskNotify.sessionLookbackDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "maximum": 7,
          "description": "How many recent session-date directories to scan under .codex/sessions."
        }
      }
    },
    "commands": [
      {
        "command": "codexTaskNotify.testNotification",
        "title": "Codex Task Notify: Test Notification"
      },
      {
        "command": "codexTaskNotify.showDiagnostics",
        "title": "Codex Task Notify: Show Diagnostics"
      },
      {
        "command": "codexTaskNotify.showRecentHistory",
        "title": "Codex Task Notify: Show Recent History"
      },
      {
        "command": "codexTaskNotify.installLocalCli",
        "title": "Codex Task Notify: Install Local CLI"
      },
      {
        "command": "codexTaskNotify.installWorkspaceCli",
        "title": "Codex Task Notify: Install Workspace CLI"
      }
    ]
  }
}
